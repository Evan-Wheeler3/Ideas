{
  "name": "shotboard",
  "version": "0.1.0",
  "description": "Storyboard and shot list tool with a simple 3D stage",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "web": "vite --config vite.web.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "smoke:electron": "electron-vite build && SHOTBOARD_SOFTWARE_GL=1 SHOTBOARD_SCREENSHOT=test-output/electron.png xvfb-run -a electron . --no-sandbox",
    "check": "npm run typecheck && npm test && npm run smoke"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/postprocessing": "^3.1.3",
    "immer": "^11.1.18",
    "jszip": "^3.10.2",
    "lucide-react": "^1.50.0",
    "nanoid": "^6.0.1",
    "postprocessing": "^6.39.5",
    "react": "19.2",
    "react-dom": "19.2",
    "react-resizable-panels": "^4.14.1",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.1",
    "electron-vite": "^5.0.0",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  }
}
